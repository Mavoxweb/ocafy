{
  "name": "@ocafy/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate && biome check --write drizzle src",
    "db:migrate": "node --env-file-if-exists=../../apps/web/.env.local ./node_modules/drizzle-kit/bin.cjs migrate"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "drizzle-orm": "^0.45.3"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.7.3"
  }
}
