{
  "expo": {
    "name": "Ocafy",
    "slug": "ocafy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "../../assets/ocafy-icone.svg",
    "scheme": "ocafy",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "../../assets/ocafy-icone.svg",
        "backgroundColor": "#FFB7C5"
      },
      "package": "com.ocafy.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router"],
    "extra": {
      "eas": {
        "projectId": "ocafy-android-app"
      }
    }
  }
}
