# Copie para apps/web/.env.local e preencha (Console Neon → Connect).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.REGION.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-xxx.neonauth.REGION.aws.neon.tech/neondb/auth/.well-known/jwks.json
# openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# --- Endereço público do app (usado nos links dos e-mails; NUNCA vem do navegador) ---
APP_URL=https://ocafy.vercel.app

# --- E-mail transacional (Resend). Opcional: sem a chave, nada é enviado e o app segue normal. ---
# 1) resend.com → Domains → adicionar o domínio e criar os registros DNS (SPF/DKIM)
# 2) resend.com → API Keys → criar chave "Sending access"
RESEND_API_KEY=
EMAIL_FROM="Ocafy <ola@seudominio.com.br>"
# opcional
EMAIL_REPLY_TO=
# Webhook (Resend → Webhooks → https://SEU-DOMINIO/api/webhooks/resend): "Signing secret" (whsec_…)
RESEND_WEBHOOK_SECRET=

# --- Documentos legais (Termos de Uso e Política de Privacidade): dados da empresa ---
# Não invente valores: preencha com os dados reais. Enquanto faltarem, as páginas /termos e /privacidade
# mostram "[a preencher]". Veja docs/legal/REVISAO-JURIDICA.md.
LEGAL_CONTROLLER_NAME=
LEGAL_CNPJ=
LEGAL_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_DPO_NAME=
LEGAL_DPO_EMAIL=
